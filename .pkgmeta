package-as: CheckThat

# The addon lives in CheckThat/ inside the repository; move it to the top of the package.
move-folders:
  CheckThat/CheckThat: CheckThat

# The Ace3 libraries and LibDeflate are committed under CheckThat/Libs, so nothing is fetched at package time.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - .claude
  - .github
  - skills
  - .venv
  - CLAUDE.md
  - AGENTS.md
  - CONTRIBUTING.md
  - README.md
  - DESIGN.md
  - docs
  - openspec
  - tests
  - tools
  - plans
  - schema
  - build
  - evidence
  - evidence-src
  - Makefile
  - requirements.txt
  - requirements-tui.txt
  - THIRD_PARTY.md
