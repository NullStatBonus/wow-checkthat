{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wow-checkthat/schema/test-plan.schema.json",
  "title": "WTT test plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "wtt",
    "addon",
    "title",
    "sections"
  ],
  "properties": {
    "wtt": {
      "const": 1
    },
    "kind": {
      "const": "plan"
    },
    "addon": {
      "enum": [
        "CheckThat",
        "KeepThat",
        "DontDoThat",
        "ClosestVendor"
      ],
      "description": "Slash allow list is shipped in the runner, never in the plan."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "preamble": {
      "type": "string",
      "description": "Once-per-run setup shown before the first step."
    },
    "handoff": {
      "type": "string",
      "description": "What to do after the last step."
    },
    "logs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/logSource"
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/requirement"
      }
    },
    "macros": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/macro"
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  },
  "$defs": {
    "logSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "global",
        "path",
        "format"
      ],
      "properties": {
        "global": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "format": {
          "enum": [
            "strings",
            "entries"
          ]
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "probe": {
          "enum": [
            "addon-loaded",
            "global-value",
            "frame-shown"
          ]
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "op": {
          "enum": [
            "eq",
            "ne",
            "gt",
            "lt",
            "contains",
            "exists"
          ]
        },
        "value": {}
      }
    },
    "macro": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "maxLength": 255
        }
      }
    },
    "clients": {
      "type": "array",
      "items": {
        "enum": [
          "classic-era",
          "forever-camelot"
        ]
      },
      "uniqueItems": true
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "steps"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "intro": {
          "type": "string"
        },
        "clients": {
          "$ref": "#/$defs/clients"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "setup": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "share": {
          "enum": [
            "none",
            "reload",
            "export"
          ],
          "description": "Applied to the last step of the section."
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "manual",
            "copy-slash",
            "secure-macro",
            "reload",
            "wait-event"
          ]
        },
        "text": {
          "type": "string"
        },
        "macro": {
          "type": "string"
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "matcher": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "equals": {
          "type": "string"
        },
        "contains": {
          "type": "string"
        },
        "pattern": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "assertion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "source"
          ],
          "properties": {
            "kind": {
              "const": "log"
            },
            "source": {
              "type": "string"
            },
            "equals": {
              "type": "string"
            },
            "contains": {
              "type": "string"
            },
            "pattern": {
              "type": "string",
              "maxLength": 200
            },
            "scope": {
              "enum": [
                "attempt",
                "session"
              ]
            },
            "absent": {
              "type": "boolean"
            },
            "diagnostic": {
              "type": "boolean"
            },
            "label": {
              "type": "string",
              "description": "Player-readable name of this check, shown on the card while CheckThat watches for it."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "source",
            "sequence"
          ],
          "properties": {
            "kind": {
              "const": "log-sequence"
            },
            "source": {
              "type": "string"
            },
            "sequence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/matcher"
              }
            },
            "scope": {
              "enum": [
                "attempt",
                "session"
              ]
            },
            "diagnostic": {
              "type": "boolean"
            },
            "label": {
              "type": "string",
              "description": "Player-readable name of this check, shown on the card while CheckThat watches for it."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "probe",
            "op"
          ],
          "properties": {
            "kind": {
              "const": "state"
            },
            "probe": {
              "enum": [
                "addon-loaded",
                "global-value",
                "frame-shown"
              ]
            },
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "op": {
              "enum": [
                "eq",
                "ne",
                "gt",
                "lt",
                "contains",
                "exists"
              ]
            },
            "value": {},
            "diagnostic": {
              "type": "boolean"
            },
            "label": {
              "type": "string",
              "description": "Player-readable name of this check, shown on the card while CheckThat watches for it."
            }
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "action",
        "expect",
        "verify"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "title": {
          "type": "string"
        },
        "clients": {
          "$ref": "#/$defs/clients"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "setup": {
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "expect": {
          "type": "string"
        },
        "verify": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "player",
              "assertions",
              "reviewer"
            ]
          },
          "uniqueItems": true
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "reviewer": {
          "type": "string",
          "description": "Reviewer-only instruction kept verbatim in exports."
        },
        "screenshot": {
          "type": "boolean"
        },
        "auto": {
          "type": "boolean",
          "description": "CheckThat records the result itself when every required assertion is met. Needs assertions in verify, no player, and at least one required assertion that is not an absence check."
        },
        "timeout": {
          "type": "integer",
          "minimum": 5,
          "maximum": 300,
          "description": "Seconds after the step opens when an auto step settles with the evidence it has. Auto steps only."
        },
        "cleanup": {
          "type": "string"
        },
        "reload": {
          "enum": [
            "none",
            "after_action"
          ]
        },
        "notes": {
          "type": "string"
        },
        "share": {
          "enum": [
            "none",
            "reload",
            "export"
          ],
          "description": "After this step: ask for a reload (logs reach saved variables) or open the export string."
        }
      },
      "allOf": [
        {
          "if": { "required": ["auto"], "properties": { "auto": { "const": true } } },
          "then": {
            "required": ["assertions"],
            "properties": {
              "verify": { "contains": { "const": "assertions" }, "not": { "contains": { "const": "player" } } },
              "assertions": {
                "contains": { "not": { "required": ["diagnostic"], "properties": { "diagnostic": { "const": true } } } },
                "items": {
                  "if": { "required": ["absent"], "properties": { "absent": { "const": true } } },
                  "then": { "required": ["diagnostic"], "properties": { "diagnostic": { "const": true } } }
                }
              }
            }
          },
          "else": { "not": { "required": ["timeout"] } }
        },
        {
          "if": { "required": ["action"], "properties": { "action": { "required": ["kind"], "properties": { "kind": { "const": "wait-event" } } } } },
          "then": { "required": ["auto"], "properties": { "auto": { "const": true } } }
        }
      ]
    }
  }
}