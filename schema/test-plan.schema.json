{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wow-checkthat/schema/test-plan.schema.json",
  "title": "CT test plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ct",
    "addon",
    "title",
    "sections"
  ],
  "properties": {
    "ct": {
      "const": 1
    },
    "kind": {
      "const": "plan"
    },
    "addon": {
      "enum": [
        "CheckThat",
        "KeepThat",
        "DontDoThat",
        "ClosestVendor"
      ],
      "description": "Slash allow list is shipped in the runner, never in the plan."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "preamble": {
      "type": "string",
      "description": "Once-per-run setup shown before the first step."
    },
    "handoff": {
      "type": "string",
      "description": "What to do after the last step."
    },
    "logs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/logSource"
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/requirement"
      }
    },
    "macros": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/macro"
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/category"
      },
      "description": "Groups of steps the tester can pick when a run starts. Without it each section is a category."
    },
    "offline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toc"
      ],
      "description": "Tools only. Mocks, entry calls and fake events run by tools/entry_runner.lua. Compile removes it. It holds steps or groups.",
      "oneOf": [
        {
          "required": [
            "steps"
          ],
          "not": {
            "required": [
              "groups"
            ]
          }
        },
        {
          "required": [
            "groups"
          ],
          "not": {
            "required": [
              "steps"
            ]
          }
        }
      ],
      "if": {
        "not": {
          "required": [
            "level"
          ],
          "properties": {
            "level": {
              "minimum": 3
            }
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "groups"
              ]
            },
            {
              "required": [
                "savedVariables"
              ]
            },
            {
              "required": [
                "steps"
              ],
              "properties": {
                "steps": {
                  "contains": {
                    "required": [
                      "reload"
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "not": {
              "required": [
                "level"
              ],
              "properties": {
                "level": {
                  "minimum": 5
                }
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "tocs"
              ]
            }
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "level"
              ],
              "properties": {
                "level": {
                  "minimum": 4
                }
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "steps"
                  ],
                  "properties": {
                    "steps": {
                      "contains": {
                        "required": [
                          "wait"
                        ]
                      }
                    }
                  }
                },
                {
                  "required": [
                    "groups"
                  ],
                  "properties": {
                    "groups": {
                      "contains": {
                        "properties": {
                          "steps": {
                            "contains": {
                              "required": [
                                "wait"
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      ],
      "properties": {
        "toc": {
          "type": "string",
          "minLength": 1
        },
        "tocs": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "description": "Level 5. One TOC for each client the block can run on, read when ct offline or replay-flow is asked for that client (--client era, forever or both). toc stays required and is the one a run without --client uses.",
          "properties": {
            "era": {
              "type": "string",
              "minLength": 1
            },
            "forever": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "mockAfterLoad": {
          "type": "boolean"
        },
        "level": {
          "enum": [1, 2, 3, 4, 5],
          "description": "Offline level the plan opts in to. No level is level 1, the first fake-client answers. Level 2: GetBuildInfo gives the TOC interface and issecurevariable knows the game names. Level 3: the game's load order (saved variables, ADDON_LOADED, PLAYER_LOGIN, PLAYER_ENTERING_WORLD), reload steps, groups and savedVariables. Level 4: the client's event list (RegisterEvent and event steps) and a virtual clock (GetTime, time, C_Timer) with wait steps. Level 5: the client's real surface (only its game functions, its build, frames with only their type's methods)."
        },
        "savedVariables": {
          "type": "object",
          "description": "Level 3. What the saved-variables file holds: a global the TOC declares, mapped to its value. JSON keys are strings.",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "description": "Level 3. Each group gets a fresh load of the addon, with the block's mocks and its own over them, and its own savedVariables or else the block's.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "steps"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "mocks": {
                "$ref": "#/properties/offline/properties/mocks"
              },
              "savedVariables": {
                "$ref": "#/properties/offline/properties/savedVariables"
              },
              "steps": {
                "$ref": "#/properties/offline/properties/steps"
              }
            }
          }
        },
        "mocks": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "args": {
                    "type": "array"
                  },
                  "returns": {
                    "type": "array"
                  }
                }
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "args": {
                      "type": "array"
                    },
                    "returns": {
                      "type": "array"
                    }
                  }
                }
              }
            ]
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "call"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "call": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "addon",
                      "entry"
                    ],
                    "properties": {
                      "addon": {
                        "type": "string"
                      },
                      "entry": {
                        "type": "string"
                      },
                      "args": {
                        "type": "array"
                      }
                    }
                  },
                  "returns": {
                    "type": "array"
                  },
                  "throws": {
                    "type": "string"
                  }
                },
                "not": {
                  "required": [
                    "returns",
                    "throws"
                  ]
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "event"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "event": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name"
                    ],
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "args": {
                        "type": "array"
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "reload"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "reload": {
                    "const": true,
                    "description": "Level 3. /reload: logout events, saved variables kept as the game writes them, a fresh load and the login events."
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "wait"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "wait": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 86400,
                    "description": "Level 4. Seconds the virtual clock moves on. Each timer that comes due runs, in the game's order."
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mockCalls"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "mockCalls": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "api",
                      "count"
                    ],
                    "properties": {
                      "api": {
                        "type": "string"
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  },
  "$defs": {
    "logSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "global",
        "path",
        "format"
      ],
      "properties": {
        "global": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "format": {
          "enum": [
            "strings",
            "entries"
          ]
        },
        "cap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000,
          "description": "How many lines the log keeps before it drops the oldest. With it, a log that holds fewer lines is known never to have rolled, so where a step began is certain."
        },
        "quiet": {
          "type": "boolean",
          "description": "No new lines is a valid result, so an absence or a count of zero can pass. Use it for an error list."
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "probe": {
          "enum": [
            "addon-loaded",
            "global-value",
            "frame-shown"
          ]
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "op": {
          "enum": [
            "eq",
            "ne",
            "gt",
            "ge",
            "lt",
            "le",
            "contains",
            "exists",
            "missing",
            "between",
            "approx",
            "matches",
            "type",
            "in"
          ]
        },
        "value": {},
        "tolerance": {
          "type": "number",
          "minimum": 0,
          "description": "Allowed distance from value for op approx."
        }
      }
    },
    "macro": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "maxLength": 255
        }
      }
    },
    "clients": {
      "type": "array",
      "items": {
        "enum": [
          "classic-era",
          "forever-camelot"
        ]
      },
      "uniqueItems": true
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "steps"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "intro": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "description": "Default category of the steps in this section."
        },
        "covers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "Tools only: names of requirements (### Requirement: headings in the addon's openspec specs) that the steps of this section covers. ct.py coverage reads it, ct.py validate checks the names and the compiler drops it; the game never sees it."
        },
        "clients": {
          "$ref": "#/$defs/clients"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "setup": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "share": {
          "enum": [
            "none",
            "reload",
            "export"
          ],
          "description": "Applied to the last step of the section."
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "manual",
            "copy-slash",
            "secure-macro",
            "reload",
            "wait-event"
          ]
        },
        "text": {
          "type": "string"
        },
        "macro": {
          "type": "string"
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "matcher": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "equals": {
          "type": "string"
        },
        "contains": {
          "type": "string"
        },
        "pattern": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "description": "The id failed is reserved for /ct rerun failed; the validator rejects it." },
        "title": { "type": "string", "minLength": 1 },
        "intro": { "type": "string" }
      }
    },
    "count": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "exactly": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "min": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "max": { "type": "integer", "minimum": 0, "maximum": 1000 }
      },
      "description": "How many matching new lines the step needs. exactly cannot combine with min or max."
    },
    "assertion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "source", "addon", "key", "op"],
          "properties": {
            "kind": { "const": "fact" },
            "source": { "type": "string" },
            "addon": { "type": "string" },
            "key": { "type": "string" },
            "op": { "enum": ["eq","ne","gt","ge","lt","le","contains","exists","missing","between","approx","matches","type","in"] },
            "value": {},
            "tolerance": { "type": "number", "minimum": 0 },
            "which": { "enum": ["last", "any", "all"] },
            "scope": { "enum": ["attempt", "session"] },
            "count": { "$ref": "#/$defs/count" },
            "diagnostic": { "type": "boolean" },
            "label": { "type": "string", "description": "Player-readable name of this check, shown on the card while CheckThat watches for it." }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "source"
          ],
          "properties": {
            "kind": {
              "const": "log"
            },
            "source": {
              "type": "string"
            },
            "equals": {
              "type": "string"
            },
            "contains": {
              "type": "string"
            },
            "pattern": {
              "type": "string",
              "maxLength": 200
            },
            "scope": {
              "enum": [
                "attempt",
                "session"
              ]
            },
            "absent": {
              "type": "boolean"
            },
            "count": {
              "$ref": "#/$defs/count"
            },
            "diagnostic": {
              "type": "boolean"
            },
            "label": {
              "type": "string",
              "description": "Player-readable name of this check, shown on the card while CheckThat watches for it."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "source",
            "sequence"
          ],
          "properties": {
            "kind": {
              "const": "log-sequence"
            },
            "source": {
              "type": "string"
            },
            "sequence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/matcher"
              }
            },
            "scope": {
              "enum": [
                "attempt",
                "session"
              ]
            },
            "diagnostic": {
              "type": "boolean"
            },
            "label": {
              "type": "string",
              "description": "Player-readable name of this check, shown on the card while CheckThat watches for it."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "probe",
            "op"
          ],
          "properties": {
            "kind": {
              "const": "state"
            },
            "probe": {
              "enum": [
                "addon-loaded",
                "global-value",
                "frame-shown"
              ]
            },
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "op": {
              "enum": [
                "eq",
                "ne",
                "gt",
                "ge",
                "lt",
                "le",
                "contains",
                "exists",
                "missing",
                "between",
                "approx",
                "matches",
                "type",
                "in"
              ]
            },
            "value": {},
            "tolerance": { "type": "number", "minimum": 0 },
            "diagnostic": {
              "type": "boolean"
            },
            "label": {
              "type": "string",
              "description": "Player-readable name of this check, shown on the card while CheckThat watches for it."
            }
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "dependentSchemas": { "call": { "required": ["auto"], "properties": { "auto": { "const": true } } } },
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "action",
        "expect",
        "verify"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "title": {
          "type": "string"
        },
        "clients": {
          "$ref": "#/$defs/clients"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "setup": {
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "expect": {
          "type": "string"
        },
        "verify": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "player",
              "assertions",
              "reviewer"
            ]
          },
          "uniqueItems": true
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "reviewer": {
          "type": "string",
          "description": "Reviewer-only instruction kept verbatim in exports."
        },
        "category": {
          "type": "string",
          "description": "Category of this step. Overrides the section's category."
        },
        "covers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "Tools only: names of requirements (### Requirement: headings in the addon's openspec specs) that this step covers. ct.py coverage reads it, ct.py validate checks the names and the compiler drops it; the game never sees it."
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "vars"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
              "vars": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } }
            }
          },
          "description": "Expands this step into one per case when the plan compiles. {{name}} in the step's text is replaced by the case's var. The step id becomes id.case-id."
        },
        "screenshot": {
          "type": "boolean"
        },
        "call": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "addon",
            "entry"
          ],
          "description": "An auto step calls an entry the addon registered with CheckThat.Entry when the step opens, outside combat. The outcome is a fact line [addon] entry.<entry>=<result>, so assert on it as a fact log. Literal arguments only.",
          "properties": {
            "addon": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,32}$"
            },
            "entry": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,42}$"
            },
            "args": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            }
          }
        },
        "auto": {
          "type": "boolean",
          "description": "CheckThat records the result itself when every required assertion is met. Needs assertions in verify, no player, and at least one required assertion. A check that something did not happen (an absence, a missing fact, a count with exactly or max) is judged when the timeout ends, so such a step needs a timeout."
        },
        "timeout": {
          "type": "integer",
          "minimum": 5,
          "maximum": 300,
          "description": "Seconds after the step opens when an auto step settles with the evidence it has. Auto steps only."
        },
        "cleanup": {
          "type": "string"
        },
        "reload": {
          "enum": [
            "none",
            "after_action"
          ]
        },
        "notes": {
          "type": "string"
        },
        "share": {
          "enum": [
            "none",
            "reload",
            "export"
          ],
          "description": "After this step: ask for a reload (logs reach saved variables) or open the export string."
        }
      },
      "allOf": [
        {
          "if": { "required": ["auto"], "properties": { "auto": { "const": true } } },
          "then": {
            "required": ["assertions"],
            "properties": {
              "verify": { "contains": { "const": "assertions" }, "not": { "contains": { "const": "player" } } },
              "assertions": {
                "contains": { "not": { "required": ["diagnostic"], "properties": { "diagnostic": { "const": true } } } }
              }
            }
          },
          "else": { "not": { "required": ["timeout"] } }
        },
        {
